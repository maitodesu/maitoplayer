{
  "name": "@migaku/desktop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:debug": "cd ../src-tauri && node ../ui/node_modules/@tauri-apps/cli/tauri.js build --debug --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
